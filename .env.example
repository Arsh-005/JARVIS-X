APP_NAME=JARVIS-X
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# Runtime budgets
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=16
MAX_CONTEXT_CHARS=24000

# Local persistence / workspace
DATABASE_PATH=data/jarvis.db
WORKSPACE_DIR=workspace
UPLOAD_DIR=data/uploads
AUDIT_LOG_PATH=data/audit.jsonl

# Production infrastructure (optional locally, recommended in production)
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=jarvis-memory

# Security
API_KEY=change-me-in-production
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
REQUIRE_CONFIRMATION_FOR_WRITES=true
ENABLE_LOCAL_COMPUTER_TOOLS=false
ALLOW_WEB_FETCH=true
WEB_FETCH_ALLOWED_HOSTS=

# Observability
ENABLE_PROMETHEUS=true
